# Copie para .env e preencha. Nunca faça commit do .env.

# Domínio público do app (sem https://). Necessário para os botões de salvar funcionarem atrás da Cloudflare.
APP_DOMINIO=

# Opcional: chave para cifrar as senhas de PDF guardadas (sem ela, usa a APP_SENHA).
# APP_SEGREDO=

# Senha do PostgreSQL (gere uma forte: openssl rand -base64 24)
POSTGRES_PASSWORD=

# Chave da API da Anthropic (console.anthropic.com). Sem ela, OFX/CSV funcionam, mas PDF/imagem e as dicas não.
ANTHROPIC_API_KEY=
# Opcional: modelo de cada tarefa (padrões: Haiku 5.5 para ler e classificar, Opus 5.5 para o diagnóstico)
# MODELO_EXTRACAO=claude-haiku-5-5
# MODELO_CLASSIFICACAO=claude-haiku-5-5
# MODELO_ANALISE=claude-opus-5-5

# Integração com o Asaas (Minha conta → Integrações → Chave de API). Use aspas simples: a chave começa com $.
ASAAS_API_KEY=
# Opcional: "sandbox" para testar com uma conta de testes do Asaas.
# ASAAS_AMBIENTE=sandbox
# Opcional: 0 desliga a sincronização automática a cada 6 horas.
# ASAAS_SINCRONIZACAO_AUTOMATICA=1

# Integração com o Mercado Pago (developers → Suas integrações → Credenciais de produção → Access Token).
MERCADOPAGO_ACCESS_TOKEN=
# Opcional: 0 desliga a sincronização automática a cada 6 horas.
# MERCADOPAGO_SINCRONIZACAO_AUTOMATICA=1

# Opcional: 0 desliga a consulta do CNPJ de quem recebeu um pagamento (BrasilAPI, gratuita) usada para classificar.
# Só CNPJ é consultado (dado público de empresa); CPF nunca.
# CONSULTA_CNPJ=1

# Opcional: modelo do consultor (chat). Padrão: claude-sonnet-5-5.
# MODELO_CONSULTOR=claude-sonnet-5-5
# Opcional: 0 desliga a carta da semana escrita pela IA (os avisos automáticos continuam).
# CARTA_SEMANAL=1

# Segunda camada de proteção (além do Cloudflare Access): login básico do navegador.
APP_USUARIO=
APP_SENHA=

# Token do túnel criado no painel Cloudflare Zero Trust (Networks > Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=

# Desenvolvimento local fora do Docker:
# DATABASE_URL=postgres://financeiro:senha@localhost:5432/financeiro
